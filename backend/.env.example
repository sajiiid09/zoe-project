# Supabase pooled connection for app runtime (Prisma Client)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require"

# Supabase direct connection for Prisma CLI (migrations/introspection)
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"

# Server
JWT_SECRET="replace-with-a-long-random-secret"
PORT=5000
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

# Stripe
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
