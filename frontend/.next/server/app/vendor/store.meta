{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/vendor/layout,_N_T_/vendor/store/layout,_N_T_/vendor/store/page,_N_T_/vendor/store"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/vendor/store/__PAGE__",
    "/vendor/store",
    "/vendor",
    "/_index"
  ]
}